---
interface Props {
  url: string;
}

const { url } = Astro.props;
let hostname = "";

try {
  hostname = new URL(url).hostname.toLowerCase();
} catch {
  // Relative or malformed URLs use the generic link icon.
}

const isHost = (domain: string) => hostname === domain || hostname.endsWith(`.${domain}`);
const icon = isHost("openreview.net")
  ? "openreview"
  : isHost("arxiv.org")
    ? "arxiv"
    : isHost("github.com")
      ? "github"
      : "link";
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="16"
  height="16"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {icon === "openreview" ? (
    <>
      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
      <circle cx="12" cy="12" r="3" />
    </>
  ) : icon === "arxiv" ? (
    <>
      <path d="m5 3 14 18M19 3l-6 8M11 13l-6 8" stroke-width="2.25" />
      <path d="m8 3 11 14M5 7l11 14" stroke-width="1" />
    </>
  ) : icon === "github" ? (
    <path
      fill="currentColor"
      stroke="none"
      d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.769-.244.769-.542 0-.267-.01-.975-.015-1.914-3.13.68-3.79-1.508-3.79-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.023-.7.078-.686.078-.686 1.13.079 1.725 1.16 1.725 1.16 1.005 1.723 2.638 1.225 3.28.937.102-.729.393-1.225.715-1.507-2.498-.284-5.124-1.249-5.124-5.562 0-1.229.439-2.234 1.16-3.021-.117-.285-.503-1.429.11-2.978 0 0 .945-.303 3.094 1.153A10.79 10.79 0 0 1 12 6.18c.956.005 1.919.129 2.818.379 2.148-1.456 3.092-1.153 3.092-1.153.614 1.549.228 2.693.112 2.978.722.787 1.158 1.792 1.158 3.021 0 4.325-2.63 5.275-5.136 5.553.404.35.766 1.042.766 2.1 0 1.517-.014 2.741-.014 3.113 0 .3.203.651.774.541A11.252 11.252 0 0 0 12 .75Z"
    />
  ) : (
    <>
      <path d="M10 13a5 5 0 0 0 7.07 0l3-3A5 5 0 0 0 13 2.93l-1.72 1.71M14 11a5 5 0 0 0-7.07 0l-3 3A5 5 0 0 0 11 21.07l1.71-1.71" />
      <path d="m9 15 6-6" />
    </>
  )}
</svg>
<style>
  svg {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
  }
</style>
